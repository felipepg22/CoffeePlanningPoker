{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "coffee-planning-poker": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "css"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": {
          "code": "en-US",
          "baseHref": "/en-US/"
        },
        "locales": {
          "pt-BR": {
            "translation": "src/locale/messages.pt-BR.xlf",
            "baseHref": "/pt-BR/"
          },
          "es-ES": {
            "translation": "src/locale/messages.es-ES.xlf",
            "baseHref": "/es-ES/"
          }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/coffee-planning-poker",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "@angular/localize/init",
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kB",
                  "maximumError": "20kB"
                }
              ],
              "outputHashing": "all"
            },
            "locales": {
              "localize": true,
              "i18nMissingTranslation": "warning"
            },
            "en-US": {
              "localize": [
                "en-US"
              ],
              "i18nMissingTranslation": "warning"
            },
            "pt-BR": {
              "localize": [
                "pt-BR"
              ],
              "i18nMissingTranslation": "warning"
            },
            "es-ES": {
              "localize": [
                "es-ES"
              ],
              "i18nMissingTranslation": "warning"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "coffee-planning-poker:build:production"
            },
            "development": {
              "buildTarget": "coffee-planning-poker:build:development"
            },
            "en-US": {
              "buildTarget": "coffee-planning-poker:build:development,en-US"
            },
            "pt-BR": {
              "buildTarget": "coffee-planning-poker:build:development,pt-BR"
            },
            "es-ES": {
              "buildTarget": "coffee-planning-poker:build:development,es-ES"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "watch": false
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
