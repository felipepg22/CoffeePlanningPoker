{
  "name": "coffee-planning-poker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node scripts/serve-locales.mjs",
    "start:en-US": "ng serve --configuration en-US --host 127.0.0.1 --port 4200",
    "start:pt-BR": "ng serve --configuration pt-BR --host 127.0.0.1 --port 4200",
    "start:es-ES": "ng serve --configuration es-ES --host 127.0.0.1 --port 4200",
    "start:locales": "node scripts/serve-locales.mjs",
    "api": "dotnet run --project server/CoffeePlanningPoker.Api/CoffeePlanningPoker.Api.csproj --urls http://localhost:5050",
    "build": "ng build",
    "build:locales": "ng build --configuration production,locales",
    "extract:i18n": "ng extract-i18n --format xlf --output-path src/locale --out-file messages.en-US.xlf",
    "i18n:check": "node scripts/check-i18n-coverage.mjs",
    "test": "ng test --watch=false",
    "test:api": "dotnet test CoffeePlanningPoker.slnx",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/localize": "^21.2.16",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "21.2.16",
    "@lucide/angular": "^1.21.0",
    "@microsoft/signalr": "10.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "jsdom": "29.1.1",
    "typescript": "~5.9.2",
    "vitest": "4.1.8"
  }
}
